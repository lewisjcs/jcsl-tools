{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/runtime/bin/cli.mjs\" hook session-start --host codex || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/runtime/bin/cli.mjs\" hook session-end --host codex || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
