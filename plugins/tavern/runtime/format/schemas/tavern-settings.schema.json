{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tavern:settings@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "roadmaps",
    "repositories",
    "pointerKinds",
    "leftOpenHours",
    "maxTicketsNotFinal",
    "quietMinutes",
    "sidework"
  ],
  "properties": {
    "contractId": {
      "const": "tavern:settings@1"
    },
    "roadmaps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glob",
        "milestonesHeading",
        "currentMarker"
      ],
      "properties": {
        "glob": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\*\\*"
          }
        },
        "milestonesHeading": {
          "type": "string",
          "minLength": 1
        },
        "currentMarker": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "\\*\\*"
        }
      },
      "uniqueItems": true
    },
    "pointerKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "file",
          "roadmap",
          "branch",
          "worktree",
          "pr",
          "run",
          "key",
          "link",
          "note"
        ]
      }
    },
    "leftOpenHours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxTicketsNotFinal": {
      "type": "integer",
      "minimum": 1
    },
    "quietMinutes": {
      "type": "number",
      "minimum": 0
    },
    "sidework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oldFiles",
        "mergedWorktrees",
        "untouchedShifts",
        "holdingDays"
      ],
      "properties": {
        "oldFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "folder",
              "days"
            ],
            "properties": {
              "folder": {
                "type": "string",
                "minLength": 1
              },
              "days": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "mergedWorktrees": {
          "type": "boolean"
        },
        "untouchedShifts": {
          "type": "integer",
          "minimum": 1
        },
        "holdingDays": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "guesses": {
      "type": "string"
    }
  }
}
