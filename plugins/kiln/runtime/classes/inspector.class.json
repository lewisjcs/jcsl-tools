{
  "kind": "class",
  "schemaVersion": "1.0-kernel",
  "id": "kiln:inspector",
  "version": "1.7.0",
  "audience": "personal",
  "identity": {
    "name": "Inspector",
    "tagline": "The skeptic who accepts evidence, never assurances.",
    "promise": "A verdict on whether the commits followed the plan, with one ruling per deviation.",
    "constraints": [
      "Runs after the last task of a phase, and again after each fix task.",
      "Walks the diff and re-runs every task's checks before reading the Crafter's declared deviations.",
      "Every ruling is one of justified, unjustified, or undeclared, with a reason.",
      "Names the consequence it observed in the diff, low, medium, or high, with one reason."
    ],
    "taboos": [
      "Never edits anything; its Bash is read-only git and the ticket plan's own check commands.",
      "Never rules on code quality or style.",
      "Never softens an unjustified ruling into a justified one.",
      "Never judges the diff against the ticket itself; conformance is to the plan, and the plan's coverage of the decision is gate one."
    ]
  },
  "functionRole": "reviewer",
  "members": {
    "skills": [],
    "agents": ["hosts/claude-code/agents/inspector.md", "hosts/codex/agents/inspector.md"],
    "references": []
  },
  "availableFeats": [],
  "boundaries": {
    "tools": { "allow": ["Read", "Grep", "Glob", "Bash"] },
    "paths": { "read": ["**"], "write": ["**"] },
    "data": { "allow": ["personal", "company", "public"] },
    "enforcement": { "tools": "best-effort", "paths": "best-effort", "data": "required" }
  },
  "contract": {
    "input": {
      "id": "kiln:inspector-brief@2",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "branch", "acceptance", "tasks"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "tasks": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["taskId", "goal", "commit", "covers", "doneWhen", "deviations", "repo", "branch"], "properties": { "taskId": { "type": "string", "pattern": "^task-[0-9]+$" }, "goal": { "type": "string", "minLength": 1 }, "commit": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{7,40}$" }, { "type": "null" }] }, "covers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "doneWhen": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["command", "expect"], "properties": { "command": { "type": "string", "minLength": 1 }, "expect": { "type": "string", "minLength": 1 } } } }, "deviations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "briefSaid", "did", "why"], "properties": { "kind": { "type": "string", "minLength": 1 }, "briefSaid": { "type": "string", "minLength": 1 }, "did": { "type": "string", "minLength": 1 }, "why": { "type": "string", "minLength": 1 } } } }, "repo": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 } } } }
        }
      }
    },
    "output": {
      "id": "kiln:inspector-outcome@1",
      "schemaTarget": "outcome",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "observedConsequence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "reason"],
            "properties": {
              "level": { "enum": ["low", "medium", "high"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          },
          "ruling": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "deviation", "ruling", "why"],
            "properties": {
              "task": { "type": "string", "minLength": 1 },
              "deviation": { "type": "string", "minLength": 1 },
              "ruling": { "enum": ["justified", "unjustified", "undeclared"] },
              "why": { "type": "string", "minLength": 1 }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check", "command", "exitCode", "quote"],
              "properties": {
                "check": { "type": "integer", "minimum": 1 },
                "command": { "type": "string", "minLength": 1 },
                "exitCode": { "type": "integer" },
                "quote": { "type": "string" }
              }
            }
          }
        },
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "classId", "outputContractId", "output", "evidence"],
            "properties": {
              "status": { "const": "complete" },
              "classId": { "const": "kiln:inspector" },
              "outputContractId": { "const": "kiln:inspector-outcome@1" },
              "output": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rulings", "observedConsequence"],
                "properties": {
                  "verdict": { "enum": ["conformed", "deviated-justified", "deviated-unjustified"] },
                  "rulings": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/ruling" }, { "type": "object", "properties": { "ruling": { "enum": ["justified", "undeclared"] } } }] } },
                  "changedAnything": { "type": "boolean" },
                  "observedConsequence": { "$ref": "#/$defs/observedConsequence" }
                }
              },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "classId", "rulings", "missing", "observedConsequence"],
            "properties": {
              "status": { "const": "gap" },
              "classId": { "const": "kiln:inspector" },
              "verdict": { "enum": ["conformed", "deviated-justified", "deviated-unjustified"] },
              "rulings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ruling" }, "contains": { "type": "object", "properties": { "ruling": { "const": "unjustified" } } } },
              "changedAnything": { "type": "boolean" },
              "missing": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "observedConsequence": { "$ref": "#/$defs/observedConsequence" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "classId", "requiredRole", "reason"],
            "properties": {
              "status": { "const": "reform-party" },
              "classId": { "const": "kiln:inspector" },
              "requiredRole": { "enum": ["kiln:planner", "kiln:designer"] },
              "reason": { "type": "string", "minLength": 1 },
              "rulings": { "type": "array", "items": { "$ref": "#/$defs/ruling" } }
            }
          }
        ]
      }
    }
  },
  "entrypoints": {
    "claude-code": {
      "kind": "agent",
      "path": "hosts/claude-code/agents/inspector.md",
      "projection": {
        "canonicalSources": ["hosts/claude-code/agents/inspector.md"],
        "sourceHash": "c03d571a33aaa2de8a4b6d64b256eeafbe45f71133678292aed4c6d8d73d8372"
      }
    },
    "codex": {
      "kind": "agent",
      "path": "hosts/codex/agents/inspector.md",
      "projection": {
        "canonicalSources": ["hosts/codex/agents/inspector.md"],
        "sourceHash": "572c33c1a054e9301ba82958faa7c1a5b911bed9b6c52162db31d8ee1545a0b0"
      }
    }
  },
  "modelRequirements": ["bounded-generation"],
  "capabilities": { "isolated-dispatch": "required" }
}
