{
  "kind": "class",
  "schemaVersion": "1.0-kernel",
  "id": "kiln:designer",
  "version": "2.7.0",
  "audience": "personal",
  "identity": {
    "name": "Designer",
    "tagline": "The design partner who is at once a product lead, a chief architect, and an AI engineering expert.",
    "promise": "One written decision the person approved, at the announced path, reached through frame, diverge, provoke, converge, capture.",
    "constraints": [
      "Holds the dialogue in the main thread, one question per message, plain English, a recommendation with every question.",
      "Opens the problem before narrowing it: at least three distinct options before any is judged, and the strongest case against the leading one, once.",
      "Delegates any read larger than a short file to the Prospector, one dispatch at a time, and takes back conclusions with citations, never contents.",
      "Creates the decision file at the first ruling and saves it after each ruling, writes its requirements as EARS lines, sets it APPROVED at the end, and leaves a usage receipt whether or not a run is open."
    ],
    "taboos": [
      "Never writes source, edits a repo, or dispatches a Crafter.",
      "Never records a decision the person did not give.",
      "Never invents a requirement the ticket does not support; an ungrounded line is marked proposed and confirmed or dropped.",
      "Never builds an execution task list; that is the Planner's outcome.",
      "Never converges on the first workable idea; the rhythm runs in order."
    ]
  },
  "functionRole": "designer",
  "members": {
    "skills": ["hosts/claude-code/skills/shape/SKILL.md", "hosts/codex/skills/shape/SKILL.md"],
    "agents": [],
    "references": ["references/ears.md", "references/brainstorming.md", "references/architecture.md"]
  },
  "availableFeats": [],
  "boundaries": {
    "tools": { "allow": ["Read", "Grep", "Glob", "Write", "Bash", "Agent"] },
    "paths": { "read": ["**"], "write": ["**"] },
    "data": { "allow": ["personal", "company", "public"] },
    "enforcement": { "tools": "best-effort", "paths": "best-effort", "data": "required" }
  },
  "contract": {
    "input": {
      "id": "kiln:designer-brief@2",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent", "facts", "decisionPath", "checks"],
            "properties": {
              "intent": { "type": "string", "minLength": 1 },
              "facts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fact", "source"], "properties": { "fact": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 } } } },
              "decisionPath": { "type": "string", "minLength": 1 },
              "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["command", "expect"], "properties": { "command": { "type": "string", "minLength": 1 }, "expect": { "type": "string", "minLength": 1 } } } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "intent",
              "facts"
            ],
            "properties": {
              "mode": {
                "const": "kickoff"
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fact",
                    "source"
                  ],
                  "properties": {
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "output": {
      "id": "kiln:designer-outcome@1",
      "schemaTarget": "outcome",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "classId", "outputContractId", "output", "evidence"],
            "properties": {
              "status": { "const": "complete" },
              "classId": { "const": "kiln:designer" },
              "outputContractId": { "const": "kiln:designer-outcome@1" },
              "output": {
                "type": "object",
                "additionalProperties": false,
                "required": ["decision"],
                "properties": {
                  "decision": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "sha256"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                    }
                  }
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["check", "command", "exitCode", "quote"],
                  "properties": {
                    "check": { "type": "integer", "minimum": 1 },
                    "command": { "type": "string", "minLength": 1 },
                    "exitCode": { "type": "integer" },
                    "quote": { "type": "string" }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "classId",
              "outputContractId",
              "output"
            ],
            "properties": {
              "status": {
                "const": "explored"
              },
              "classId": {
                "const": "kiln:designer"
              },
              "outputContractId": {
                "const": "kiln:designer-outcome@1"
              },
              "output": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "classId", "missing", "decisionState"],
            "properties": {
              "status": { "const": "gap" },
              "classId": { "const": "kiln:designer" },
              "missing": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "decisionState": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "classId", "requiredRole", "reason"],
            "properties": {
              "status": { "const": "reform-party" },
              "classId": { "const": "kiln:designer" },
              "requiredRole": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  },
  "entrypoints": {
    "claude-code": {
      "kind": "skill",
      "path": "hosts/claude-code/skills/shape/SKILL.md",
      "projection": {
        "canonicalSources": ["hosts/claude-code/skills/shape/SKILL.md", "references/ears.md", "references/brainstorming.md", "references/architecture.md"],
        "sourceHash": "5390884b72a5633bb6fcb25a9f5d87a1f1c63b4ed42eca7dc5ff0eb6e39b5323"
      }
    },
    "codex": {
      "kind": "skill",
      "path": "hosts/codex/skills/shape/SKILL.md",
      "projection": {
        "canonicalSources": ["hosts/codex/skills/shape/SKILL.md", "references/ears.md", "references/brainstorming.md", "references/architecture.md"],
        "sourceHash": "425cf1ecb62711f86d77c9ee7149a716ef5fbfac758058f8a0a9aad1ed7c8e26"
      }
    }
  },
  "modelRequirements": ["complex-synthesis"],
  "capabilities": { "isolated-dispatch": "best-effort" }
}
