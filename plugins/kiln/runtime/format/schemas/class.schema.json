{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "id", "version", "audience", "identity", "functionRole", "members", "availableFeats", "boundaries", "contract", "entrypoints", "modelRequirements"],
  "properties": {
    "kind": { "const": "class" },
    "schemaVersion": { "const": "1.0-kernel" },
    "id": { "$ref": "#/$defs/classOrPartyId" },
    "version": { "$ref": "#/$defs/version" },
    "audience": { "$ref": "#/$defs/audience" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline", "promise", "constraints", "taboos"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "tagline": { "$ref": "#/$defs/nonEmptyString" },
        "promise": { "$ref": "#/$defs/nonEmptyString" },
        "constraints": { "$ref": "#/$defs/stringList" },
        "taboos": { "$ref": "#/$defs/stringList" }
      }
    },
    "functionRole": { "$ref": "#/$defs/nonEmptyString" },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "agents", "references"],
      "properties": {
        "skills": { "$ref": "#/$defs/pathList" },
        "agents": { "$ref": "#/$defs/pathList" },
        "references": { "$ref": "#/$defs/pathList" },
        "hooks": { "$ref": "#/$defs/pathList" }
      },
      "anyOf": [
        { "properties": { "skills": { "type": "array", "minItems": 1 } } },
        { "properties": { "agents": { "type": "array", "minItems": 1 } } }
      ]
    },
    "availableFeats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "preconditions", "outcome"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "preconditions": { "$ref": "#/$defs/stringList" },
          "outcome": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "paths", "data", "enforcement"],
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": { "allow": { "$ref": "#/$defs/stringList" } }
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "$ref": "#/$defs/pathList" },
            "write": { "$ref": "#/$defs/pathList" }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["personal", "company", "public"] }
            }
          }
        },
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools", "paths", "data"],
          "properties": {
            "tools": { "enum": ["required", "best-effort"] },
            "paths": { "enum": ["required", "best-effort"] },
            "data": { "enum": ["required", "best-effort"] }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "$ref": "#/$defs/contractEndpoint" },
        "output": { "$ref": "#/$defs/contractEndpoint" }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "enum": ["skill", "agent"] },
            "path": { "$ref": "#/$defs/relativePosixPath" },
            "projection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonicalSources", "sourceHash"],
              "properties": {
                "canonicalSources": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/relativePosixPath" }
                },
                "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "modelRequirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/modelRequirement" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "isolated-dispatch": { "enum": ["required", "best-effort"] }
      }
    }
  },
  "$defs": {
    "audience": { "enum": ["personal", "company", "public"] },
    "classOrPartyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)+$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "modelRequirement": { "enum": ["mechanical-transformation", "bounded-generation", "complex-synthesis", "independent-judgment", "adversarial-adjudication"] },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "relativePosixPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "pathList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePosixPath" } },
    "contractEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema"],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "schema": { "type": "object" }
      }
    }
  }
}
