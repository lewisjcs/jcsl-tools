{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "id", "version", "audience", "mission", "eligibleClassIds", "requiredRoles", "contract", "handoffs"],
  "properties": {
    "kind": { "const": "party" },
    "schemaVersion": { "const": "1.0-kernel" },
    "id": { "$ref": "#/$defs/classOrPartyId" },
    "version": { "$ref": "#/$defs/version" },
    "audience": { "$ref": "#/$defs/audience" },
    "mission": { "$ref": "#/$defs/nonEmptyString" },
    "eligibleClassIds": { "$ref": "#/$defs/classOrPartyIdList" },
    "requiredRoles": { "$ref": "#/$defs/nonEmptyStringList" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputContractId", "outputContractId"],
      "properties": {
        "inputContractId": { "$ref": "#/$defs/contractId" },
        "outputContractId": { "$ref": "#/$defs/contractId" }
      }
    },
    "handoffs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromRole", "toRole", "contractId"],
        "properties": {
          "fromRole": { "$ref": "#/$defs/nonEmptyString" },
          "toRole": { "$ref": "#/$defs/nonEmptyString" },
          "contractId": { "$ref": "#/$defs/contractId" }
        }
      }
    }
  },
  "$defs": {
    "audience": { "enum": ["personal", "company", "public"] },
    "classOrPartyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)+$" },
    "classOrPartyIdList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/classOrPartyId" } },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
  }
}
