{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "location", "claim"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["High", "Medium", "Low"] },
        "category": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lens", "scope", "runId", "findings", "blockers", "belowTheLine"],
      "properties": {
        "lens": { "enum": ["adversarial-review", "threat-review", "code-quality-audit"] },
        "scope": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "belowTheLine": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classId", "outputContractId", "output", "evidence"],
      "properties": {
        "status": { "const": "complete" },
        "classId": { "type": "string", "pattern": "^jcsl:gauntlet:[a-z-]+$" },
        "outputContractId": { "const": "kiln:borrowed-review-outcome@1" },
        "output": { "allOf": [{ "$ref": "#/$defs/body" }, { "properties": { "blockers": { "maxItems": 0 } } }] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "reference"], "properties": { "kind": { "const": "file" }, "reference": { "type": "string", "minLength": 1 } } } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classId", "lens", "scope", "runId", "findings", "blockers", "belowTheLine", "missing"],
      "properties": {
        "status": { "const": "gap" },
        "classId": { "type": "string", "pattern": "^jcsl:gauntlet:[a-z-]+$" },
        "lens": { "enum": ["adversarial-review", "threat-review", "code-quality-audit"] },
        "scope": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "belowTheLine": { "type": "integer", "minimum": 0 },
        "missing": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
