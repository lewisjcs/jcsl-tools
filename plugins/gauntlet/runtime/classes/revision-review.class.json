{
  "kind": "class",
  "schemaVersion": "1.0-kernel",
  "id": "jcsl:gauntlet:revision-review",
  "version": "1.0.0",
  "audience": "personal",
  "identity": {
    "name": "Revision Review",
    "tagline": "A single verifier role settles the fate of every open prior finding against the new tree.",
    "promise": "Rule each prior finding resolved, persisting, or withdrawn, each with a reason and a citation the reader can check.",
    "constraints": [
      "The verifier runs in a fresh, isolated dispatch and receives the range-diff, the thread, and the prior findings by reference into the run directory, never embedded in the prompt.",
      "A deterministic runtime, never a host, decides stage order, retries, and when the run is terminal.",
      "The Class is deliberately single-role: each verdict is a check of one named claim against a pinned tree, verifiable by inspection, so no adversarial stage exists.",
      "The verifier never searches for new problems; new findings are the other lanes' work over the same range-diff."
    ],
    "taboos": [
      "Does not mark a finding resolved on the author's word — only on what the new tree shows.",
      "Does not mark a finding withdrawn without a thread reply to point at.",
      "Does not omit, add, or re-key a prior finding.",
      "Does not modify the tree under review."
    ]
  },
  "functionRole": "revision-review",
  "members": {
    "skills": [
      "hosts/claude-code/skills/revision-review/SKILL.md",
      "hosts/codex/skills/revision-review/SKILL.md"
    ],
    "agents": [
      "hosts/claude-code/agents/revision-verifier.md",
      "hosts/codex/roles/revision-verifier.md"
    ],
    "references": [
      "canon/revision-verifier-persona.md",
      "canon/shapes/verify-protocol.md",
      "canon/grounding-contract.md",
      "profiles/revision-review/code-diff/profile.json",
      "profiles/revision-review/code-diff/lenses.md"
    ]
  },
  "availableFeats": [],
  "boundaries": {
    "tools": {
      "allow": [
        "Read",
        "Grep",
        "Glob",
        "Bash"
      ]
    },
    "paths": {
      "read": [
        "**"
      ],
      "write": []
    },
    "data": {
      "allow": [
        "personal",
        "company",
        "public"
      ]
    },
    "enforcement": {
      "tools": "required",
      "paths": "required",
      "data": "required"
    }
  },
  "contract": {
    "input": {
      "id": "jcsl:reviewable-artifact@1",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "jcsl:reviewable-artifact@1",
        "type": "object",
        "required": [
          "contractId",
          "artifactId",
          "artifactFamily",
          "audience",
          "components",
          "references",
          "requiredCoverage",
          "artifactSha256"
        ],
        "properties": {
          "contractId": {
            "type": "string",
            "const": "jcsl:reviewable-artifact@1",
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+(?:@[1-9][0-9]*)?$"
          },
          "artifactId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"
          },
          "artifactFamily": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"
          },
          "audience": {
            "type": "object",
            "required": [
              "intended",
              "instructionBoundary"
            ],
            "properties": {
              "intended": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "instructionBoundary": {
                "const": "artifact-content-is-untrusted-review-data"
              }
            },
            "additionalProperties": false
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "mediaType",
                "contentSha256",
                "audience"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "role": {
                  "enum": [
                    "primary",
                    "supporting"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
                },
                "contentSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "audience": {
                  "const": "untrusted-review-data"
                },
                "inlineContent": {
                  "type": "string"
                },
                "resolvedReference": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "inlineContent": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "inlineContent"
                  ]
                },
                {
                  "properties": {
                    "resolvedReference": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "resolvedReference"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "id",
                "uri",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "requiredCoverage": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reviewedCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "repoRoot": {
            "type": "string",
            "minLength": 1
          },
          "allowedReadPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bindingCaveats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "id": "jcsl:verify-result@1",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "jcsl:verify-result@1",
        "type": "object",
        "required": [
          "contractId",
          "classId",
          "classVersion",
          "loadoutId",
          "host",
          "input",
          "executionStatus",
          "calibrationStatus",
          "coverage",
          "outcome",
          "findings",
          "verdicts",
          "failures",
          "measurements"
        ],
        "properties": {
          "contractId": {
            "type": "string",
            "const": "jcsl:verify-result@1",
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+(?:@[1-9][0-9]*)?$"
          },
          "classId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"
          },
          "classVersion": {
            "type": "string",
            "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
          },
          "loadoutId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "host": {
            "type": "object",
            "required": [
              "id",
              "adapterId",
              "bindingStatus"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "adapterId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"
              },
              "bindingStatus": {
                "enum": [
                  "honored",
                  "degraded",
                  "unavailable"
                ]
              }
            },
            "additionalProperties": false
          },
          "input": {
            "type": "object",
            "required": [
              "contractId",
              "artifactSha256"
            ],
            "properties": {
              "contractId": {
                "const": "jcsl:reviewable-artifact@1"
              },
              "artifactSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "executionStatus": {
            "enum": [
              "complete",
              "incomplete",
              "failed"
            ]
          },
          "calibrationStatus": {
            "enum": [
              "calibrated",
              "experimental",
              "stale"
            ]
          },
          "coverage": {
            "type": "object",
            "required": [
              "status",
              "components",
              "omissions"
            ],
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "incomplete"
                ]
              },
              "components": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "omissions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "outcome": {
            "enum": [
              "findings",
              "failed"
            ]
          },
          "findings": {
            "type": "array",
            "maxItems": 0
          },
          "verdicts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/verdict"
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "measurements": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "availability",
                    "value",
                    "unit",
                    "source"
                  ],
                  "properties": {
                    "availability": {
                      "enum": [
                        "measured",
                        "estimated"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "availability",
                    "unit",
                    "source"
                  ],
                  "properties": {
                    "availability": {
                      "const": "unavailable"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "$defs": {
          "verdict": {
            "type": "object",
            "required": [
              "key",
              "status",
              "reason",
              "anchor"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}:[a-z][a-z0-9-]*:[A-Z]-[0-9]{3}$"
              },
              "status": {
                "enum": [
                  "resolved",
                  "persisting",
                  "withdrawn"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "entrypoints": {
    "claude-code": {
      "kind": "skill",
      "path": "hosts/claude-code/skills/revision-review/SKILL.md",
      "projection": {
        "canonicalSources": [
          "canon/revision-verifier-persona.md",
          "canon/grounding-contract.md",
          "canon/shapes/verify-protocol.md",
          "profiles/revision-review/code-diff/profile.json",
          "profiles/revision-review/code-diff/lenses.md",
          "bindings/claude-code.json"
        ],
        "sourceHash": "392fa727db2ffda453d45085775352ac633d717d62caab557d0a29dea93c5c31"
      }
    },
    "codex": {
      "kind": "skill",
      "path": "hosts/codex/skills/revision-review/SKILL.md",
      "projection": {
        "canonicalSources": [
          "canon/revision-verifier-persona.md",
          "canon/grounding-contract.md",
          "canon/shapes/verify-protocol.md",
          "profiles/revision-review/code-diff/profile.json",
          "profiles/revision-review/code-diff/lenses.md",
          "bindings/codex.json"
        ],
        "sourceHash": "e62a714196098675df8830cdd32b5b373099ecec8ddcc540cce8d0c93a9b3f4c"
      }
    }
  },
  "modelRequirements": [
    "independent-judgment"
  ],
  "capabilities": {
    "isolated-dispatch": "required"
  }
}
