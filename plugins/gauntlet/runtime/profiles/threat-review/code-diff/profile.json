  "marker": "Artifact type: code-diff",
  "lensFile": "profiles/threat-review/code-diff/lenses.md",
  "locationFormats": ["file:line (post-diff path for changed files; repo-relative reviewed-tree path for cross-boundary findings); also emit file and line as separate fields"],
