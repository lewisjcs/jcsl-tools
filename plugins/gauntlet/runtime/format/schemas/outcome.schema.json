{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classId", "outputContractId", "output", "evidence"],
      "properties": {
        "status": { "const": "complete" },
        "classId": { "$ref": "#/$defs/classOrPartyId" },
        "outputContractId": { "$ref": "#/$defs/contractId" },
        "output": {},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference"],
            "properties": {
              "kind": { "$ref": "#/$defs/nonEmptyString" },
              "reference": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classId", "missing"],
      "properties": {
        "status": { "const": "gap" },
        "classId": { "$ref": "#/$defs/classOrPartyId" },
        "missing": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classId", "requiredRole", "reason"],
      "properties": {
        "status": { "const": "reform-party" },
        "classId": { "$ref": "#/$defs/classOrPartyId" },
        "requiredRole": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  ],
  "$defs": {
    "classOrPartyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)+$" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
  }
}
