{
  "kind": "roster-policy",
  "version": "1.3.0",
  "pool": [
    {
      "classKey": "adversarial-review",
      "classId": "jcsl:gauntlet:adversarial-review",
      "families": [
        "code-diff",
        "plan-text",
        "doc-text"
      ]
    },
    {
      "classKey": "code-quality-audit",
      "classId": "jcsl:gauntlet:code-quality-audit",
      "families": [
        "code-diff"
      ]
    },
    {
      "classKey": "revision-review",
      "classId": "jcsl:gauntlet:revision-review",
      "families": [
        "code-diff"
      ]
    },
    {
      "classKey": "threat-review",
      "classId": "jcsl:gauntlet:threat-review",
      "families": [
        "code-diff"
      ]
    }
  ],
  "rows": [
    {
      "rowId": "code-behavioral-revision",
      "match": {
        "family": "code-diff",
        "mechanicalOnly": false,
        "revision": true
      },
      "field": [
        {
          "classKey": "revision-review",
          "reason": "revision of a posted review — prior findings need a fate"
        },
        {
          "classKey": "adversarial-review",
          "reason": "behavioral code diff — adversarial surface"
        },
        {
          "classKey": "code-quality-audit",
          "reason": "code diff — rulebook audit applies"
        },
        {
          "classKey": "threat-review",
          "when": "security-signal",
          "reason": "security signal fired — the change touches a trust surface"
        }
      ],
      "skip": [],
      "gaps": [
        {
          "lane": "go-live-review",
          "when": "golive-flag",
          "reason": "applicable, not yet admitted — run its skill manually"
        }
      ]
    },
    {
      "rowId": "code-mechanical-revision",
      "match": {
        "family": "code-diff",
        "mechanicalOnly": true,
        "revision": true
      },
      "field": [
