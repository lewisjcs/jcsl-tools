          "reason": "security signal fired — the change touches a trust surface"
        }
      ],
      "skip": [
        {
          "classKey": "adversarial-review",
          "reason": "mechanical-only diff — no behavioral surface to attack"
        }
      ],
      "gaps": [
        {
          "lane": "go-live-review",
          "when": "golive-flag",
          "reason": "applicable, not yet admitted — run its skill manually"
        },
        {
          "lane": "doc-review",
          "when": "doc-only",
          "reason": "applicable, not yet admitted — run its skill manually"
        }
