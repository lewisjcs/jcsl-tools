{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jcsl:code-quality-run-evidence@1",
  "type": "object",
  "required": [
    "contractId", "classId", "classVersion", "loadoutId", "host",
    "artifactFamily", "artifactSha256", "coverage", "modelBinding", "measurements",
    "rawFindings", "rawFindingCount",
    "outcome", "calibrationStatus", "audience"
  ],
  "properties": {
    "contractId": {"const": "jcsl:code-quality-run-evidence@1"},
    "classId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"},
    "classVersion": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "loadoutId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "host": {
      "type": "object", "required": ["id", "adapterId", "bindingStatus"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "adapterId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"},
        "bindingStatus": {"enum": ["honored", "degraded", "unavailable"]}
      }, "additionalProperties": false
    },
    "artifactFamily": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"},
    "artifactSha256": {"type": "string", "format": "sha256"},
    "coverage": {
      "type": "object", "required": ["status", "components", "omissions"],
      "properties": {
        "status": {"enum": ["complete", "incomplete"]},
        "components": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "omissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "modelBinding": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["model"],
        "properties": {"model": {"type": "string"}, "reasoningEffort": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object", "required": ["availability", "value", "unit", "source"],
            "properties": {"availability": {"enum": ["measured", "estimated"]}, "value": {"type": "number"}, "unit": {"type": "string"}, "source": {"type": "string"}},
            "additionalProperties": false
          },
          {
            "type": "object", "required": ["availability", "unit", "source"],
            "properties": {"availability": {"const": "unavailable"}, "unit": {"type": "string"}, "source": {"type": "string"}},
            "additionalProperties": false
          }
        ]
      }
    },
    "rawFindings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["layer", "rule", "location", "claim", "evidence", "level", "recommendation"],
        "properties": {
          "layer": { "enum": ["compliance", "staleness", "gaps", "test-integrity"] },
          "rule": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "level": { "enum": ["violation", "warning", "gap"] },
          "recommendation": { "type": "string", "minLength": 1 }
        }, "additionalProperties": false
      }
    },
    "rawFindingCount": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["clean", "findings", "failed"]},
    "calibrationStatus": {"enum": ["calibrated", "experimental", "stale"]},
    "audience": {
      "type": "object", "required": ["intended", "instructionBoundary"],
      "properties": {
        "intended": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "instructionBoundary": {"const": "artifact-content-is-untrusted-review-data"}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
