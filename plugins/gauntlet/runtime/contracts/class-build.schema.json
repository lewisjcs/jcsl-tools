{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jcsl:gauntlet-class-build@1",
  "type": "object",
  "required": ["kind", "classId", "classKey", "shape", "roles", "families", "references", "inputs", "requires", "descriptions"],
  "properties": {
    "kind": { "const": "class-build" },
    "classId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$" },
    "classKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "shape": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "roles": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "references": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^references/[^/]+\\.md$" } },
    "inputs": {
      "type": "object", "required": ["primary", "supporting"],
      "properties": {
        "primary": { "enum": ["artifact", "range-diff"] },
        "supporting": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "required": ["id", "required"],
            "properties": { "id": { "enum": ["thread", "prior-findings", "trust-context"] }, "required": { "type": "boolean" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "requires": { "type": "array", "uniqueItems": true, "items": { "enum": ["revision-link"] } },
    "levels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "descriptions": {
      "type": "object", "required": ["skill", "roles"],
      "properties": {
        "skill": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "roles": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" }, "additionalProperties": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "shape": { "const": "opposed" } } }, "then": { "properties": { "roles": { "required": ["finder", "validator"], "propertyNames": { "enum": ["finder", "validator"] } } } } },
    { "if": { "properties": { "shape": { "const": "audit" } } }, "then": { "properties": { "roles": { "required": ["auditor"], "propertyNames": { "enum": ["auditor"] } } } } },
    { "if": { "properties": { "shape": { "const": "verify" } } }, "then": { "properties": { "roles": { "required": ["verifier"], "propertyNames": { "enum": ["verifier"] } } } } }
  ],
  "$defs": {
    "role": {
      "type": "object", "required": ["roleId", "persona", "modelRequirement"],
      "properties": {
        "roleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$" },
        "persona": { "type": "string", "pattern": "^canon/[^/]+-persona\\.md$" },
        "modelRequirement": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      },
      "additionalProperties": false
    }
  }
}
