{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jcsl:revision-policy@1",
  "type": "object",
  "required": ["kind", "version", "match", "proximity"],
  "properties": {
    "kind": { "const": "revision-policy" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "match": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["lane", "sublens", "file"] }
    },
    "proximity": {
      "type": "object",
      "required": ["lines"],
      "properties": { "lines": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
